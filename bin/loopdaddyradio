#!/usr/bin/env bash
# Catalog and audio-only playback helper for the Loop Daddy Radio Omarchy plugin.
set -euo pipefail

CHANNEL="${LOOPDADDY_CHANNEL:-https://www.youtube.com/@MarcRebillet}"
STATE_DIR="${LOOPDADDY_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/loopdaddyradio}"
CACHE="$STATE_DIR/catalog.json"
ENABLED_FILE="$STATE_DIR/enabled"
MIN_DURATION="${LOOPDADDY_MIN_DURATION:-90}"
MAX_AGE="${LOOPDADDY_CACHE_MAX_AGE:-86400}"

usage() {
  cat <<'USAGE'
Usage:
  loopdaddyradio catalog [--refresh]   Print the cached track catalog as JSON
  loopdaddyradio play <id> [title] [start]   Play one YouTube video, audio only
                                             Optional start is seconds from the beginning
  loopdaddyradio enabled [on|off]      Read or write the persisted on/off flag
USAGE
}

fail() {
  echo "loopdaddyradio: $*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || fail "missing dependency: $1"
}

ensure_state_dir() {
  mkdir -p "$STATE_DIR"
}

cache_age() {
  if [[ ! -f $CACHE ]]; then
    echo 999999
    return
  fi
  echo $(( $(date +%s) - $(stat -c %Y "$CACHE") ))
}

refresh_catalog() {
  need yt-dlp
  need jq
  ensure_state_dir
  local tmp
  tmp=$(mktemp "$STATE_DIR/catalog.XXXXXX")
  yt-dlp \
    --flat-playlist \
    --no-warnings \
    --ignore-errors \
    --print "%(.{id,title,duration,live_status,was_live})j" \
    "$CHANNEL/videos" \
    "$CHANNEL/streams" \
    | jq -s \
      --arg channel "$CHANNEL" \
      --argjson min "$MIN_DURATION" \
      '
      unique_by(.id)
      | map(select(
          (.id | type == "string") and (.id | length) > 0
          and (.live_status != "is_live")
          and (.live_status != "is_upcoming")
          and ((.duration | type) == "number")
          and (.duration >= $min)
        ))
      | {
          channel: $channel,
          fetchedAt: (now | floor),
          tracks: map({id, title: (.title // "Untitled"), duration})
        }
      ' > "$tmp"
  local count
  count=$(jq '.tracks | length' "$tmp")
  [[ ${count:-0} -gt 0 ]] || { rm -f "$tmp"; fail "catalog refresh returned no playable tracks"; }
  mv "$tmp" "$CACHE"
}

print_catalog() {
  local refresh="${1:-}"
  if [[ $refresh == --refresh ]]; then
    refresh_catalog
  elif [[ ! -f $CACHE ]]; then
    refresh_catalog
  else
    local age
    age=$(cache_age)
    if (( age >= MAX_AGE )); then
      refresh_catalog
    fi
  fi
  cat "$CACHE"
}

mpris_script() {
  local candidate
  for candidate in \
    /usr/lib/mpv-mpris/mpris.so \
    /etc/mpv/scripts/mpris.so \
    /usr/lib/mpv/scripts/mpris.so
  do
    if [[ -f $candidate ]]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

play_track() {
  local id="${1:-}"
  local title="${2:-Loop Daddy Radio}"
  local start="${3:-0}"
  [[ -n $id ]] || fail "play requires a YouTube video id"
  [[ $start =~ ^[0-9]+$ ]] || fail "start must be a whole number of seconds"
  need mpv
  need yt-dlp
  local args=(
    --no-config
    --ytdl=yes
    --no-video
    --vo=null
    --force-window=no
    --audio-display=no
    --audio-client-name="Loop Daddy Radio"
    --ytdl-format=bestaudio/best
    --really-quiet
    --no-terminal
    --keep-open=no
    --loop-file=no
    --cache=yes
    --start="$start"
    --force-media-title="$title"
    --title="Loop Daddy Radio"
    --osd-playing-msg=
  )
  local mpris=""
  mpris=$(mpris_script || true)
  if [[ -n $mpris ]]; then
    args+=(--script="$mpris")
  fi
  exec mpv "${args[@]}" "https://www.youtube.com/watch?v=${id}"
}

enabled_state() {
  local value="${1:-}"
  ensure_state_dir
  if [[ -z $value ]]; then
    if [[ -f $ENABLED_FILE ]]; then
      tr -d '[:space:]' < "$ENABLED_FILE"
      echo
    else
      echo off
    fi
    return
  fi
  case "$value" in
    on|off) printf '%s\n' "$value" > "$ENABLED_FILE" ;;
    *) fail "enabled must be on or off" ;;
  esac
}

cmd="${1:-}"
case "$cmd" in
  catalog)
    shift
    print_catalog "${1:-}"
    ;;
  play)
    shift
    play_track "${1:-}" "${2:-}" "${3:-0}"
    ;;
  enabled)
    shift
    enabled_state "${1:-}"
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    fail "unknown command: $cmd"
    ;;
esac
